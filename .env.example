# Brevo (set these in Vercel > Project > Settings > Environment Variables)
BREVO_API_KEY=
# Address that receives the inquiries
INQUIRY_TO=
# Sender verified in Brevo (Senders, domains & dedicated IPs)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Maison De Sacy
# Optional: Brevo list id for clients who ask to receive news
BREVO_LIST_ID=
