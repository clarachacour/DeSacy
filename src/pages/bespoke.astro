---
import Base from '../layouts/Base.astro';
import BespokeBlock from '../components/BespokeBlock.astro';
---
<Base title="Bespoke" nav="bespoke" description="Bespoke steel wall sculptures by De Sacy for private homes and architectural projects, from sketch to installation.">
  <BespokeBlock />
  <section class="block process" id="process">
    <div class="wrap">
      <div class="sec-head"><div><span class="label">One workshop, from sketch to steel</span><h2>How a piece is made</h2></div></div>
      <ol class="steps">
        <li><h3>Sketch</h3><p>Every sculpture starts as a pencil line. The best drawings are scaled up to full size on paper.</p></li>
        <li><h3>Cut</h3><p>The outline is cut from sheet steel, then the edges are ground smooth by hand.</p></li>
        <li><h3>Shape</h3><p>Each strip is bent and twisted cold, so the steel holds the curve of the drawing.</p></li>
        <li><h3>Weld</h3><p>Parts are joined with small, hidden welds, then ground until the seam disappears.</p></li>
        <li><h3>Finish</h3><p>Hand painted or powder coated, then fitted with a wall bracket that floats it off the wall.</p></li>
      </ol>
    </div>
  </section>
</Base>
