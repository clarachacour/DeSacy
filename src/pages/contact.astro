---
import Base from '../layouts/Base.astro';
import { CONTACT, getArtworks } from '../lib/site';

const titles = Object.fromEntries((await getArtworks()).map((a) => [a.id, a.data.title]));
---
<Base title="Contact" nav="contact" description="Contact Maison De Sacy about a sculpture, a De Sacy Studio piece or a commission.">
  <section class="block page-top">
    <div class="wrap split">
      <div>
        <span class="label">Contact</span>
        <h1 style="margin-block:14px 22px;font-size:clamp(30px,4.4vw,48px);line-height:1.1">Write to Maison De Sacy</h1>
        <div class="prose">
          <p>For availability, prices, a Studio order or a commission, write a few lines or call. You will get a reply within two working days.</p>
          <p>
            Phone: {CONTACT.phones.map((p, i) => <>{i > 0 && ' · '}<a href={`tel:${p.replace(/\s/g, '')}`}><strong>{p}</strong></a></>)}<br />
            Email: <a href={`mailto:${CONTACT.email}`}><strong>{CONTACT.email}</strong></a><br />
            Instagram: <a href={`https://www.instagram.com/${CONTACT.instagram}/`} rel="noopener"><strong>@{CONTACT.instagram}</strong></a><br />
            Studio: {CONTACT.city}
          </p>
        </div>
      </div>
      <div>
        <form class="inq" data-kind="contact" novalidate data-titles={JSON.stringify(titles)}>
          <div class="row2">
            <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" maxlength="100" /></div>
            <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
          </div>
          <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" maxlength="200" /></div>
          <div class="field"><label for="f-topic">About</label>
            <select id="f-topic" name="topic">
              <option value="artwork">De Sacy Artwork sculpture</option>
              <option value="studio">De Sacy Studio piece</option>
              <option value="commission">Commission</option>
              <option value="press">Gallery or press request</option>
              <option value="other">Something else</option>
            </select>
          </div>
          <input type="hidden" name="piece" />
          <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" maxlength="5000"></textarea></div>
          <label class="check"><input type="checkbox" name="newsletter" value="yes" /> I would like to hear about new pieces and collections.</label>
          <div class="hp" aria-hidden="true"><label>Leave empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="note" data-note>Your details are only used to answer you.</p>
          <div><button class="btn" type="submit">Send</button></div>
        </form>
      </div>
    </div>
  </section>
</Base>
<script>
  import { wireInquiryForms } from '../scripts/inquiry';
  const form = document.querySelector<HTMLFormElement>('form[data-kind="contact"]')!;
  const titles: Record<string, string> = JSON.parse(form.dataset.titles ?? '{}');
  const params = new URLSearchParams(location.search);
  const piece = params.get('piece'), topic = params.get('topic');
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  if (piece && titles[piece]) {
    field('topic').value = 'artwork';
    field('piece').value = titles[piece];
    field('message').value = `Hello, I would like to know more about "${titles[piece]}".`;
  } else if (topic && ['artwork', 'studio', 'commission', 'press', 'other'].includes(topic)) {
    field('topic').value = topic;
  }
  wireInquiryForms();
</script>
