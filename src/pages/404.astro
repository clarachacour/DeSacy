---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="block page-top">
    <div class="wrap">
      <span class="label">404</span>
      <h1 style="margin-block:14px 22px;font-size:clamp(30px,4.4vw,48px);line-height:1.1">This page does not exist</h1>
      <div class="prose"><p>The page may have moved. The collection is still here.</p></div>
      <div class="actions"><a class="btn" href="/artwork">See the works</a><a class="btn ghost" href="/">Home</a></div>
    </div>
  </section>
</Base>
