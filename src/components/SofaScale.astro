---
// The piece drawn to scale above a 220 cm sofa, hung 25 cm above its back.
interface Props { title: string; width: number; height: number }
const { title, width, height } = Astro.props;
const k = Math.min(1.4, 380 / width), floor = 182, sofaW = 220 * k, sofaH = 85 * k, sx = (400 - sofaW) / 2;
const pw = width * k, ph = height * k, px = 200 - pw / 2, py = Math.max(4, floor - sofaH - 25 * k - ph);
---
<div class="scale">
  <span class="label">Size on the wall, next to a 220 cm sofa</span>
  <svg viewBox="0 0 400 190" role="img" aria-label={`${title} is ${width} by ${height} cm, shown above a 220 cm sofa`}>
    <line x1="0" y1={floor} x2="400" y2={floor} stroke="#d9dadb" />
    <rect x={sx} y={floor - sofaH} width={sofaW} height={sofaH} rx="10" fill="#e4e4e2" />
    <rect x={px} y={py} width={pw} height={ph} fill="none" stroke="#151617" stroke-width="1.5" />
    <text x={px + pw / 2} y={py + ph / 2 + 4} text-anchor="middle" font-family="Jost, sans-serif" font-size="11" fill="#151617">{width} × {height} cm</text>
    <text x="200" y={floor - sofaH / 2 + 4} text-anchor="middle" font-family="Jost, sans-serif" font-size="11" fill="#5d6166">sofa 220 cm</text>
  </svg>
</div>
